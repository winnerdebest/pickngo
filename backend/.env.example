# PickNGo Backend Environment Variables

# App Config
PROJECT_NAME="PickNGo API"
ENVIRONMENT="development"
DEBUG=True

# Database (Default is local SQLite, Render automatically populates PostgreSQL URL)
DATABASE_URL="sqlite:///./pickngo.db"
# Example PostgreSQL URL: postgresql://pickngo_user:password@dpg-xxxx.render.com/pickngo_db

# Security & Session Secret (Generate a strong random string in production)
SECRET_KEY="replace-with-a-very-strong-secret-key-for-pickngo"

# SQLAdmin Authentication Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_this_admin_password_in_production"
