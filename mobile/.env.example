# PickNGo Mobile Environment Configuration Template
# Duplicate this file as .env and fill in your values

# Backend API Base URL (e.g., https://your-backend.onrender.com/api/v1 or http://192.168.1.X:8000/api/v1 for local testing)
EXPO_PUBLIC_API_URL=https://pickngo.onrender.com/api/v1

# Backend WebSocket Base URL (e.g., wss://your-backend.onrender.com or ws://192.168.1.X:8000 for local testing)
EXPO_PUBLIC_WS_URL=wss://pickngo.onrender.com
